{
  "name": "new-tab",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-version.js",
    "dev": "vite",
    "prebuild": "node scripts/sync-version.js",
    "build": "tsc -b && vite build",
    "version": "node scripts/sync-version.js && git add public/manifest.json",
    "patch": "npm version patch --no-git-tag-version && node scripts/sync-version.js",
    "minor": "npm version minor --no-git-tag-version && node scripts/sync-version.js",
    "major": "npm version major --no-git-tag-version && node scripts/sync-version.js",
    "sync": "node scripts/sync-version.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:lines": "node scripts/check-lines.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.563.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^4.0.8",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.8"
  }
}
